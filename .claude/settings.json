{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(npx supabase:*)",
      "Bash(supabase:*)",
      "Bash(npx wrangler:*)",
      "Bash(wrangler:*)",
      "Bash(stripe:*)",
      "Bash(npm publish:*)",
      "Bash(curl:*)",
      "mcp__github",
      "mcp__Canva",
      "mcp__Mobbin__save_content",
      "mcp__Mobbin__create_collection",
      "mcp__Mobbin__add_comment"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && node scripts/dashboard.mjs >/dev/null 2>&1; node scripts/office.mjs >/dev/null 2>&1 || true" }
        ]
      }
    ]
  }
}
